{
    "name": "codecat",
    "displayName": "CodeCat",
    "description": "Concatenate selected files and copy to clipboard",
    "version": "1.0.0",
    "publisher": "Unclecode",
    "repository": "https://github.com/unclecode/codecat-vscode",
    "engines": {
        "vscode": "^1.98.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onCommand:codecat.concatFiles"
    ],
    "contributes": {
        "commands": [
            {
                "command": "codecat.concatFiles",
                "title": "Concat",
                "category": "CodeCat"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "codecat.concatFiles",
                    "group": "navigation",
                    "when": "explorerResourceIsFolder == false"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "vscode:prepublish": "npm run compile",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "@types/node": "^16.11.7",
        "@types/vscode": "^1.98.0",
        "@typescript-eslint/eslint-plugin": "^5.30.0",
        "@typescript-eslint/parser": "^5.30.0",
        "eslint": "^8.13.0",
        "typescript": "^4.7.2",
        "vsce": "^2.15.0"
    }
}